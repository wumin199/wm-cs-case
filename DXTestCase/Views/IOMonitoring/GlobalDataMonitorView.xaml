<UserControl
    x:Class="DXTestCase.Views.IOMonitoring.GlobalDataMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:DXTestCase.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:io="clr-namespace:DXTestCase.Models.IO"
    xmlns:local="clr-namespace:DXTestCase.Views.IOMonitoring"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:EnumTypeToVisibilityConverter x:Key="EnumTypeToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <dxg:TreeViewControl
            Grid.Column="0"
            AutoExpandAllNodes="True"
            ChildNodesPath="MonitorEntries"
            ItemsSource="{Binding MonitorRoot}"
            SelectedItem="{Binding SelectedEntry}"
            ShowBorder="True"
            TreeViewFieldName="Name" />
        <GridSplitter
            Grid.Column="1"
            Width="10"
            Padding="4,0,4,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch" />

        <Grid Grid.Column="2">
            <DataGrid
                AutoGenerateColumns="False"
                BorderThickness="1"
                CanUserSortColumns="False"
                GridLinesVisibility="All"
                HorizontalGridLinesBrush="#E0E0E0"
                IsReadOnly="True"
                ItemsSource="{Binding UserIntData}"
                SelectionMode="Single"
                VerticalGridLinesBrush="#E0E0E0"
                Visibility="{Binding SelectedEntry, Converter={StaticResource EnumTypeToVisibilityConverter}, ConverterParameter=DataType:UserInt}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Name}"
                        Header="名称" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Value}"
                        Header="值" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Description}"
                        Header="描述">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="#F5F5F5" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid
                AutoGenerateColumns="False"
                BorderThickness="1"
                CanUserSortColumns="False"
                GridLinesVisibility="All"
                HorizontalGridLinesBrush="#E0E0E0"
                IsReadOnly="True"
                ItemsSource="{Binding UserRealData}"
                SelectionMode="Single"
                VerticalGridLinesBrush="#E0E0E0"
                Visibility="{Binding SelectedEntry, Converter={StaticResource EnumTypeToVisibilityConverter}, ConverterParameter=DataType:UserReal}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Name}"
                        Header="名称" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Value}"
                        Header="值" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Description}"
                        Header="描述">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="#F5F5F5" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid
                AutoGenerateColumns="False"
                BorderThickness="1"
                CanUserSortColumns="False"
                GridLinesVisibility="All"
                HorizontalGridLinesBrush="#E0E0E0"
                IsReadOnly="True"
                ItemsSource="{Binding UserByteData}"
                SelectionMode="Single"
                VerticalGridLinesBrush="#E0E0E0"
                Visibility="{Binding SelectedEntry, Converter={StaticResource EnumTypeToVisibilityConverter}, ConverterParameter=DataType:UserByte}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Name}"
                        Header="名称" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Value}"
                        Header="值" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Description}"
                        Header="描述">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="#F5F5F5" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid
                AutoGenerateColumns="False"
                BorderThickness="1"
                CanUserSortColumns="False"
                GridLinesVisibility="All"
                HorizontalGridLinesBrush="#E0E0E0"
                IsReadOnly="True"
                ItemsSource="{Binding UserUShortData}"
                SelectionMode="Single"
                VerticalGridLinesBrush="#E0E0E0"
                Visibility="{Binding SelectedEntry, Converter={StaticResource EnumTypeToVisibilityConverter}, ConverterParameter=DataType:UserUShort}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Name}"
                        Header="名称" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Value}"
                        Header="值" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Description}"
                        Header="描述">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="#F5F5F5" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid
                AutoGenerateColumns="False"
                BorderThickness="1"
                CanUserSortColumns="False"
                GridLinesVisibility="All"
                HorizontalGridLinesBrush="#E0E0E0"
                IsReadOnly="True"
                ItemsSource="{Binding PRData}"
                SelectionMode="Single"
                VerticalGridLinesBrush="#E0E0E0"
                Visibility="{Binding SelectedEntry, Converter={StaticResource EnumTypeToVisibilityConverter}, ConverterParameter=DataType:PR}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Name}"
                        Header="名称" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Value}"
                        Header="值" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Description}"
                        Header="描述">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="#F5F5F5" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid
                AutoGenerateColumns="False"
                BorderThickness="1"
                CanUserSortColumns="False"
                GridLinesVisibility="All"
                HorizontalGridLinesBrush="#E0E0E0"
                IsReadOnly="True"
                ItemsSource="{Binding SysIntData}"
                SelectionMode="Single"
                VerticalGridLinesBrush="#E0E0E0"
                Visibility="{Binding SelectedEntry, Converter={StaticResource EnumTypeToVisibilityConverter}, ConverterParameter=DataType:SysInt}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Name}"
                        Header="名称" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Value}"
                        Header="值" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Description}"
                        Header="描述">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="#F5F5F5" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid
                AutoGenerateColumns="False"
                BorderThickness="1"
                CanUserSortColumns="False"
                GridLinesVisibility="All"
                HorizontalGridLinesBrush="#E0E0E0"
                IsReadOnly="True"
                ItemsSource="{Binding SysRealData}"
                SelectionMode="Single"
                VerticalGridLinesBrush="#E0E0E0"
                Visibility="{Binding SelectedEntry, Converter={StaticResource EnumTypeToVisibilityConverter}, ConverterParameter=DataType:SysReal}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Name}"
                        Header="名称" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Value}"
                        Header="值" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Description}"
                        Header="描述">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="#F5F5F5" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid
                AutoGenerateColumns="False"
                BorderThickness="1"
                CanUserSortColumns="False"
                GridLinesVisibility="All"
                HorizontalGridLinesBrush="#E0E0E0"
                IsReadOnly="True"
                ItemsSource="{Binding SysRealData}"
                SelectionMode="Single"
                VerticalGridLinesBrush="#E0E0E0"
                Visibility="{Binding SelectedEntry, Converter={StaticResource EnumTypeToVisibilityConverter}, ConverterParameter=DataType:SysReal}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Name}"
                        Header="名称" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Value}"
                        Header="值" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Description}"
                        Header="描述">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="#F5F5F5" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>


        </Grid>
    </Grid>
</UserControl>
